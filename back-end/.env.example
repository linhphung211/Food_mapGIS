# Foodmap Spring Boot Backend — Environment Variables
# Copy file này thành .env và điền thông tin thực tế

# ===== DATABASE (PostgreSQL + PostGIS) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=foodmap
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your_password

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
# Phải có ít nhất 64 ký tự (256 bits) cho HS256
JWT_SECRET_KEY=foodmap-secret-key-change-this-in-production-must-be-at-least-256-bits

# ===== EMAIL (Gmail App Password) =====
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# ===== SUPABASE S3 =====
SUPABASE_S3_ACCESS_KEY=your-supabase-s3-access-key
SUPABASE_S3_SECRET_KEY=your-supabase-s3-secret-key
SUPABASE_S3_ENDPOINT=https://your-project-id.supabase.co/storage/v1/s3
SUPABASE_PROJECT_ID=your-project-id
